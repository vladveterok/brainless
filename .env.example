# n8n Configuration
# The timezone to set for the n8n instance
GENERIC_TIMEZONE=UTC

# The public HTTPS URL provided by localtunnel or ngrok
WEBHOOK_URL=https://your-tunnel-url.loca.lt

# Telegram Configuration
# Go to BotFather on Telegram, create a new bot, and paste the API token here.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq Configuration (for later phases)
GROQ_API_KEY=your_groq_api_key_here
