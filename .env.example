# n8n Configuration
# The timezone to set for the n8n instance
GENERIC_TIMEZONE=UTC

# Storage Mode (local or github)
# Use 'local' if running on your laptop with Obsidian Local REST API.
# Use 'github' if hosting in the cloud to push Markdown files to a GitHub repo.
STORAGE_MODE=github

# Telegram Configuration
# Go to BotFather on Telegram, create a new bot, and paste the API token here.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq Configuration (for later phases)
GROQ_API_KEY=your_groq_api_key_here
# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# --- Obsidian Local Storage Configuration (if STORAGE_MODE=local) ---
OBSIDIAN_API_KEY=your_obsidian_local_rest_api_key_here

# --- GitHub Cloud Storage Configuration (if STORAGE_MODE=github) ---
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_obsidian_vault_repo
GITHUB_TOKEN=your_github_personal_access_token
