        "text": "=✅ <b>Successfully saved to Vault!</b>\n\n📄 <b>{{$node[\"Set Normalized Insights\"].json.telegram_title}}</b>\n🏷️ Tags: {{$node[\"Set Normalized Insights\"].json.tags.join(', ')}}\n\n---\n{{$node[\"Set Normalized Insights\"].json.telegram_content}}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
