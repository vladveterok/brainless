    {
      "parameters": {
        "mode": "append"
      },
      "id": "merge-payload",
      "name": "Merge Payload",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent?key={{$env[\"GEMINI_API_KEY\"]}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"contents\": [ { \"parts\": [ { \"text\": \"Custom User Instructions:\\n\" + ($node[\"Message Parser\"].json.user_prompt ? $node[\"Message Parser\"].json.user_prompt : 'None provided.') + \"\\n\\nTask:\\nReturn ONLY valid JSON with keys: 'title', 'tags', and 'content'.\\nIf no Custom User Instructions are provided, 'content' must be a 3-sentence summary and 5 key takeaways formatted in Markdown.\\nIf Custom User Instructions ARE provided, ignore the default summary format. Instead, 'content' must contain the detailed response to the Custom User Instructions formatted in Markdown.\\n\\nText: \" + ($json.raw_content || $json.text || $json.data || $json.original_text || '') } ] } ], \"generationConfig\": { \"responseMimeType\": \"application/json\" } } }}",
        "options": {}
      },
      "id": "gemini-ai-node",
      "name": "Gemini AI Node",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1500,
        300
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 15000
    },
    {
      "parameters": {
        "jsCode": "const responseText = $json.candidates[0].content.parts[0].text;\n\n// Strip potential markdown backticks just in case\nconst cleanJson = responseText.replace(/```json\\n?|```/g, '').trim();\nconst parsed = JSON.parse(cleanJson);\n\nconst tags = parsed.tags || [];\nconst markdownContent = `---\\ntags: [${tags.join(', ')}]\\nsource: ${$node[\"Message Parser\"].json.route}\\n---\\n# ${parsed.title}\\n\\n${parsed.content}`;\n\nconst telegramSafeContent = (parsed.content || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst telegramSafeTitle = (parsed.title || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nreturn {\n    json: {\n        title: parsed.title,\n        tags: tags,\n        content: parsed.content,\n        telegram_content: telegramSafeContent,\n        telegram_title: telegramSafeTitle,\n        base64_content: Buffer.from(markdownContent).toString('base64')\n    }\n};"
      },
      "id": "set-normalized-insights",
      "name": "Set Normalized Insights",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst text = $json.message.text || '';\nconst urlRegex = /(https?:\\/\\/[^\\s]+)/;\nconst match = text.match(urlRegex);\n\nlet target_url = null;\nlet user_prompt = text.trim();\nlet route = 'text';\n\nif (match) {\n    target_url = match[1];\n    user_prompt = text.replace(target_url, '').trim();\n    \n    if (target_url.includes('youtube.com') || target_url.includes('youtu.be')) {\n        route = 'youtube';\n    } else {\n        route = 'article';\n    }\n}\n\nreturn {\n    json: {\n        target_url: target_url,\n        user_prompt: user_prompt,\n        route: route,\n        original_text: text\n    }\n};\n"
      },
      "id": "c05597db-77a9-4a78-a18d-0eeb915068bb",
      "name": "Message Parser",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        -300
      ]
    },
